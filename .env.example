# =============================================================================
# Variables de configuración para Docker Compose.
# -----------------------------------------------------------------------------
# Este archivo contiene los valores necesarios para configurar los servicios
# del proyecto cuando se ejecutan con Docker.
#
# Para utilizarlo, copia este archivo y crea uno llamado .env en la carpeta
# principal del proyecto. Después, puedes modificar los valores necesarios.
#
# Docker Compose lee automáticamente este archivo al iniciar el proyecto.
# Si no existe, utilizará los valores predeterminados y podrás iniciar
# el proyecto con: docker compose up --build
#
# IMPORTANTE: el archivo .env contiene información privada y no debe
# subirse al repositorio. Por eso está incluido en .gitignore.
# =============================================================================

#  PostgreSQL 
POSTGRES_USER=readingclub
POSTGRES_PASSWORD=readingclub_pwd
POSTGRES_DB=readingclub
POSTGRES_PORT=5432

#  Backend (API Express) 
BACKEND_PORT=4000
# Secreto usado para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=change_me_in_production_super_secret_key
# Vigencia del token (ejemplos: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
# Origen del frontend autorizado por CORS (debe coincidir con FRONTEND_PORT)
CORS_ORIGIN=http://localhost:3000

#  Frontend (Next.js) 
FRONTEND_PORT=3000
# URL de la API tal como la ve el NAVEGADOR. Se incrusta en el frontend al compilar.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
