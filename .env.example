# =============================================================================
# Variables de entorno para DOCKER COMPOSE (raíz del proyecto)
# -----------------------------------------------------------------------------
# Uso: copia este archivo a ".env" en la misma carpeta y ajusta los valores.
#     cp .env.example .env
#
# Docker Compose lee automáticamente el archivo ".env" de esta carpeta.
# Si no existe ".env", el docker-compose.yml usa valores por defecto y el
# proyecto igual levanta con:  docker compose up --build
#
# IMPORTANTE: el archivo ".env" real NUNCA se sube al repositorio (.gitignore).
# =============================================================================

# ------------------------------- PostgreSQL ----------------------------------
POSTGRES_USER=readingclub
POSTGRES_PASSWORD=readingclub_pwd
POSTGRES_DB=readingclub
POSTGRES_PORT=5432

# --------------------------- Backend (API Express) ---------------------------
BACKEND_PORT=4000
# Secreto usado para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=change_me_in_production_super_secret_key
# Vigencia del token (ejemplos: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
# Origen del frontend autorizado por CORS (debe coincidir con FRONTEND_PORT)
CORS_ORIGIN=http://localhost:3000

# --------------------------- Frontend (Next.js) ------------------------------
FRONTEND_PORT=3000
# URL de la API tal como la ve el NAVEGADOR. Se incrusta en el frontend al compilar.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
