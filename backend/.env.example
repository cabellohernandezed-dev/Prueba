# =============================================================================
# Variables de entorno del BACKEND
# -----------------------------------------------------------------------------
# Estas variables se utilizan cuando ejecutas el backend directamente
# en tu computadora, sin utilizar Docker.
#
# Para configurarlas, copia el archivo .env.example y crea uno llamado .env.
#
# Si utilizas Docker, las variables se configuran automáticamente
# desde el archivo docker-compose.yml, por lo que no necesitas hacerlo aquí.
#
# IMPORTANTE: el archivo .env contiene información privada y no debe
# subirse al repositorio. Por eso está incluido en .gitignore.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL.
# - Cuando ejecutamos el proyecto en nuestra computadora, usamos "localhost"
#   para conectarnos a la base de datos.
# - Cuando ejecutamos el proyecto con Docker, usamos "postgres",
#   que es el nombre del contenedor de la base de datos.
DATABASE_URL=postgresql://readingclub:readingclub_pwd@localhost:5432/readingclub?schema=public

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=change_me_in_production_super_secret_key

# Vigencia del token (ejemplos: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Origen del frontend autorizado por CORS.
CORS_ORIGIN=http://localhost:3000
