# =============================================================================
# Variables de entorno del BACKEND
# -----------------------------------------------------------------------------
# Úsalas si ejecutas el backend FUERA de Docker (desarrollo local):
#     cp .env.example .env
#
# Dentro de Docker estas variables se inyectan desde el docker-compose.yml
# de la raíz, por lo que aquí NO necesitas configurar nada.
#
# IMPORTANTE: el archivo ".env" real nunca se sube al repositorio (.gitignore).
# =============================================================================

NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL.
# - En local usamos "localhost" (el contenedor de Postgres expone el puerto).
# - En Docker el host es "postgres" (nombre del servicio) y ya viene configurado.
DATABASE_URL=postgresql://readingclub:readingclub_pwd@localhost:5432/readingclub?schema=public

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=change_me_in_production_super_secret_key

# Vigencia del token (ejemplos: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Origen del frontend autorizado por CORS.
CORS_ORIGIN=http://localhost:3000
