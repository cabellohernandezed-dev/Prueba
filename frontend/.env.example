# =============================================================================
# Variables de entorno del FRONTEND (Next.js)
# -----------------------------------------------------------------------------
# Úsalas si ejecutas el frontend FUERA de Docker:
#     cp .env.example .env
#
# Las variables con prefijo NEXT_PUBLIC_ se incrustan en el bundle en tiempo
# de compilación, por eso son visibles en el navegador.
#
# IMPORTANTE: el archivo ".env" real nunca se sube al repositorio (.gitignore).
# =============================================================================

# URL base de la API del backend tal y como la ve el NAVEGADOR.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
