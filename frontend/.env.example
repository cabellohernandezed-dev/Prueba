# =============================================================================
# Variables de configuración del frontend (Next.js).
# -----------------------------------------------------------------------------
# Estas variables se utilizan cuando ejecutas el frontend directamente
# en tu computadora, sin utilizar Docker.
#
# Para configurarlas, copia el archivo .env.example y crea uno llamado .env.
#
# Las variables que comienzan con NEXT_PUBLIC_ pueden verse desde el navegador,
# por lo que no debes guardar contraseñas ni información privada en ellas.
#
# IMPORTANTE: el archivo .env contiene información privada y no debe
# subirse al repositorio. Por eso está incluido en .gitignore.
# =============================================================================

# URL base de la API del backend tal y como la ve el NAVEGADOR.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
